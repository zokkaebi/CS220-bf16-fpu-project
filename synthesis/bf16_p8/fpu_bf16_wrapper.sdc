set_output_delay -clock clk  -max 0.1  [get_ports {out[6]}]
set_output_delay -clock clk  -max 0.1  [get_ports {out[5]}]
set_output_delay -clock clk  -max 0.1  [get_ports {out[4]}]
set_output_delay -clock clk  -max 0.1  [get_ports {out[3]}]
set_output_delay -clock clk  -max 0.1  [get_ports {out[2]}]
set_output_delay -clock clk  -max 0.1  [get_ports {out[1]}]
set_output_delay -clock clk  -max 0.1  [get_ports {out[0]}]
set_output_delay -clock clk  -max 0.1  [get_ports inf]
set_output_delay -clock clk  -max 0.1  [get_ports snan]
set_output_delay -clock clk  -max 0.1  [get_ports qnan]
