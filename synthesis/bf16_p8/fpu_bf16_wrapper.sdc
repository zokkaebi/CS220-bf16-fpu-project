set_input_delay -clock clk  -max 0.1  [get_ports {opa[5]}]
set_input_delay -clock clk  -max 0.1  [get_ports {opa[4]}]
set_input_delay -clock clk  -max 0.1  [get_ports {opa[3]}]
set_input_delay -clock clk  -max 0.1  [get_ports {opa[2]}]
set_input_delay -clock clk  -max 0.1  [get_ports {opa[1]}]
set_input_delay -clock clk  -max 0.1  [get_ports {opa[0]}]
set_input_delay -clock clk  -max 0.1  [get_ports {opb[15]}]
set_input_delay -clock clk  -max 0.1  [get_ports {opb[14]}]
set_input_delay -clock clk  -max 0.1  [get_ports {opb[13]}]
set_input_delay -clock clk  -max 0.1  [get_ports {opb[12]}]
set_input_delay -clock clk  -max 0.1  [get_ports {opb[11]}]
set_input_delay -clock clk  -max 0.1  [get_ports {opb[10]}]
set_input_delay -clock clk  -max 0.1  [get_ports {opb[9]}]
set_input_delay -clock clk  -max 0.1  [get_ports {opb[8]}]
set_input_delay -clock clk  -max 0.1  [get_ports {opb[7]}]
set_input_delay -clock clk  -max 0.1  [get_ports {opb[6]}]
set_input_delay -clock clk  -max 0.1  [get_ports {opb[5]}]
set_input_delay -clock clk  -max 0.1  [get_ports {opb[4]}]
set_input_delay -clock clk  -max 0.1  [get_ports {opb[3]}]
set_input_delay -clock clk  -max 0.1  [get_ports {opb[2]}]
set_input_delay -clock clk  -max 0.1  [get_ports {opb[1]}]
set_input_delay -clock clk  -max 0.1  [get_ports {opb[0]}]
set_output_delay -clock clk  -max 0.1  [get_ports {out[15]}]
set_output_delay -clock clk  -max 0.1  [get_ports {out[14]}]
set_output_delay -clock clk  -max 0.1  [get_ports {out[13]}]
set_output_delay -clock clk  -max 0.1  [get_ports {out[12]}]
