###################################################################

# Created by write_sdc on Sun Nov  8 20:59:11 2026

###################################################################
set sdc_version 2.1

set_units -time ns -resistance MOhm -capacitance fF -voltage V -current uA
create_clock [get_ports clk]  -period 8  -waveform {0 4}
set_clock_uncertainty 0.2  [get_clocks clk]
set_input_delay -clock clk  -max 0.1  [get_ports {rmode[1]}]
set_input_delay -clock clk  -max 0.1  [get_ports {rmode[0]}]
set_input_delay -clock clk  -max 0.1  [get_ports {fpu_op[2]}]
set_input_delay -clock clk  -max 0.1  [get_ports {fpu_op[1]}]
set_input_delay -clock clk  -max 0.1  [get_ports {fpu_op[0]}]
set_input_delay -clock clk  -max 0.1  [get_ports {opa[15]}]
set_input_delay -clock clk  -max 0.1  [get_ports {opa[14]}]
set_input_delay -clock clk  -max 0.1  [get_ports {opa[13]}]
set_input_delay -clock clk  -max 0.1  [get_ports {opa[12]}]
set_input_delay -clock clk  -max 0.1  [get_ports {opa[11]}]
